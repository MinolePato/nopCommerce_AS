{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "jaeger",     "name": "Jaeger",     "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "nopCommerce — Catalogue Search & Product View Flow. Tracks search volume, zero-result rate, result count distribution, and product page activity.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Searches per interval",
      "description": "Number of searches per display interval split by whether results were found. A spike in found_results=false means the catalogue is missing content or the search index is broken.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "bars" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "sum(increase(nop_nop_catalog_searches_total[$__rate_interval])) by (found_results)",
          "legendFormat": "found_results={{found_results}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Zero-result search rate",
      "description": "Fraction of searches returning 0 products. Above 30% signals catalogue gaps or a broken search index — actionable before users start abandoning the site.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.10 },
              { "color": "red",    "value": 0.30 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(nop_nop_catalog_searches_total{found_results=\"false\"}[5m])) / sum(rate(nop_nop_catalog_searches_total[5m]))",
          "legendFormat": "zero-result rate",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Total searches (last 5 min)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(increase(nop_nop_catalog_searches_total[5m]))",
          "legendFormat": "searches",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Discounted product views / min",
      "description": "Product pricing requests split by whether a discount was applied. A rising has_discount=true bar confirms an active discount campaign is driving traffic; a sudden drop signals a discount rule was accidentally deactivated.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "bars" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "has_discount=true" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "has_discount=false" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "sum(increase(nop_nop_catalog_pricing_requests_total[$__rate_interval])) by (has_discount)",
          "legendFormat": "has_discount={{has_discount}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Product views per interval — by stock status",
      "description": "Product page views split by stock availability. A rising in_stock=false bar means customers are repeatedly hitting unavailable products — lost revenue that requires restocking or unpublishing.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "bars" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "in_stock=false" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "in_stock=true" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "sum(increase(nop_nop_catalog_product_views_total[$__rate_interval])) by (in_stock)",
          "legendFormat": "in_stock={{in_stock}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Product page latency — p50 / p95",
      "description": "HTTP response time for product detail pages. A rising p95 signals slow pricing/picture queries or DB pressure.",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 4 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(nop_http_server_request_duration_seconds_bucket{http_route=\"\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(nop_http_server_request_duration_seconds_bucket{http_route=\"\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },

    {
      "id": 9,
      "title": "Product views by category",
      "description": "Product page views split by product category per interval. Shows which categories drive the most traffic — rising bars for a category with high out-of-stock products signals lost revenue.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "bars" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "sum(increase(nop_nop_catalog_product_views_total[$__rate_interval])) by (product_category)",
          "legendFormat": "{{product_category}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "title": "\"Call for price\" product views",
      "description": "Views of premium products where price is hidden (call for price) per interval. A rising trend indicates demand for high-value items — useful for sales team prioritisation.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "bars" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "sum(increase(nop_nop_catalog_product_views_total{is_call_for_price=\"true\"}[$__rate_interval]))",
          "legendFormat": "call-for-price views",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Recent catalog.search traces (click row → Jaeger)",
      "description": "Traces filtered to only those containing a catalog.search span. Each row shows the parent HTTP request (GET /search) — this is a Jaeger display constraint; the catalog.search span and its tags are visible inside each trace.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "uid": "jaeger", "type": "jaeger" },
      "fieldConfig": {
        "defaults": { "custom": { "displayMode": "auto" } },
        "overrides": []
      },
      "options": { "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "catalog.search",
          "tags": "search.has_keyword=true",
          "limit": 20
        }
      ]
    },

    {
      "id": 8,
      "title": "Recent catalog.product.view traces (click row → Jaeger)",
      "description": "Traces containing a catalog.product.view span. Each row shows the parent HTTP request (GET /{slug}) — click to open the full trace in Jaeger where catalog.product.view and catalog.pricing are visible.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 34 },
      "datasource": { "uid": "jaeger", "type": "jaeger" },
      "fieldConfig": {
        "defaults": { "custom": { "displayMode": "auto" } },
        "overrides": []
      },
      "options": { "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "catalog.product.view",
          "limit": 20
        }
      ]
    },

    {
      "id": 12,
      "title": "Out-of-stock product views — trace list",
      "description": "Traces where a product with no stock was viewed (product.in_stock=false). Each row links to the full trace — open it to see product.name, product.category, and all pricing spans. Use this to identify which specific products customers are hitting that they cannot buy.",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 44 },
      "datasource": { "uid": "jaeger", "type": "jaeger" },
      "fieldConfig": {
        "defaults": { "custom": { "displayMode": "auto" } },
        "overrides": []
      },
      "options": { "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "catalog.product.view",
          "tags": "product.in_stock=false",
          "limit": 20
        }
      ]
    },

    {
      "id": 13,
      "title": "Call-for-price product views — trace list",
      "description": "Traces where a call-for-price product was viewed (product.is_call_for_price=true). Each row links to the full trace — open it to see product.id. Use this to identify which premium products are generating demand.",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 44 },
      "datasource": { "uid": "jaeger", "type": "jaeger" },
      "fieldConfig": {
        "defaults": { "custom": { "displayMode": "auto" } },
        "overrides": []
      },
      "options": { "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "nopCommerce",
          "operation": "catalog.product.view",
          "tags": "product.is_call_for_price=true",
          "limit": 20
        }
      ]
    }

  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["nopcommerce", "catalog", "search", "opentelemetry"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "nopCommerce — Catalogue Search & Product View",
  "uid": "nop-catalog-search",
  "version": 2
}
